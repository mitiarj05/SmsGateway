<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Par défaut : HTTPS uniquement (prod = Vercel en HTTPS). -->
    <base-config cleartextTrafficPermitted="false" />
    <!-- Builds debug : HTTP autorisé (serveur LAN en dev, ex. http://192.168.x.x:3000).
         Ne s'applique JAMAIS aux builds release. -->
    <debug-overrides cleartextTrafficPermitted="true" />
</network-security-config>
